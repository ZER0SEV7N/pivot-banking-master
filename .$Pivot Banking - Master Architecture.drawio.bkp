            <mxPoint x="1660" y="936" as="sourcePoint" />
            <mxPoint x="1850" y="936" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c45" value="16 · insert YANKI_PAYMENT (idempotente por transactionId)" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.2;fontStyle=0;fontColor=#15803D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1666" y="920" width="430" height="14" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fontStyle=0;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="24" height="14" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Rama wallet-to-wallet (sin tarjeta vinculada)&lt;/b&gt;&lt;br&gt;ms-yanki debita el wallet origen, acredita el destino y marca COMPLETED: publica &lt;b&gt;yanki.payment.result&lt;/b&gt; sin pasar por ms-account.&lt;br&gt;El asiento YANKI_PAYMENT lo registra ms-transaction al consumir el resultado (flujo idempotente)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#BE123C;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1005" width="900" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Garantías y compensación&lt;/b&gt;&lt;br&gt;• Si ms-account no puede debitar/acreditar → publica FAILED con failureReason; ms-yanki revierte la reserva del wallet.&lt;br&gt;• Reintentos del consumidor no duplican asientos: la clave de idempotencia es &lt;b&gt;transactionId&lt;/b&gt; · X-Correlation-Id viaja en headers y logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="970" y="1005" width="1040" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="&lt;div style=&quot;text-align:left;font-weight:bold;font-size:10.5px;color:#B45309;margin-bottom:6px&quot;&gt;CONTRATO DE EVENTOS · Apache Kafka (KRaft)&lt;/div&gt;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;table-layout:fixed&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:230px&quot;/&gt;&lt;col style=&quot;width:250px&quot;/&gt;&lt;col style=&quot;width:150px&quot;/&gt;&lt;col style=&quot;width:260px&quot;/&gt;&lt;col style=&quot;width:1080px&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFFBEB;color:#B45309&quot;&gt;Evento / tópico&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFFBEB;color:#B45309&quot;&gt;Clase de evento&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFFBEB;color:#B45309&quot;&gt;Productor&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFFBEB;color:#B45309&quot;&gt;Consumidores&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFFBEB;color:#B45309&quot;&gt;Payload principal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#B45309;background:#FFFBEB;&quot;&gt;&lt;b&gt;yanki.payment.requested&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;YankiPaymentRequestedEvent&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-yanki&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;transactionId · senderPhoneNumber · receiverPhoneNumber · senderDebitCardId · receiverDebitCardId · currency · amount · description · requestedAt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#B45309;background:#FFFBEB;&quot;&gt;&lt;b&gt;yanki.payment.result&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;YankiPaymentResultEvent&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account&lt;br&gt;ms-yanki (wallet-to-wallet)&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-yanki · ms-transaction&lt;/td&gt;&lt;td style=&quot;border:1px solid #FCD34D;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;transactionId · status (COMPLETED / FAILED) · failureReason · debitedAccountId · creditedAccountId · processedAt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="1970" height="152" as="geometry" />
        </mxCell>
