        <mxCell id="c52" value="FLUJO FELIZ · validación → débito → crédito → asientos" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="44" y="222" width="500" height="14" as="geometry" />
        </mxCell>
        <mxCell id="c53" value="&lt;b&gt;Compensación si falla el crédito al destino (pasos 9-12)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px&quot;&gt;ms-transaction llama a ms-account con &lt;b&gt;DEPOSIT&lt;/b&gt; sobre la cuenta origen (operación inversa de TRANSFER_OUT). Si la compensación responde, propaga el error original y &lt;b&gt;no persiste ningún asiento&lt;/b&gt;: el cliente ve el fallo y el saldo vuelve a su estado inicial.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="880" width="780" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;Reglas de la transferencia&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #BFDBFE;margin:7px 0&quot;&gt;&lt;/div&gt;· El cliente debe existir y estar &lt;b&gt;ACTIVE&lt;/b&gt; (ms-customer).&lt;br&gt;· Origen y destino deben ser cuentas distintas del mismo cliente y moneda.&lt;br&gt;· El débito valida saldo suficiente incluyendo la comisión por exceso de movimientos.&lt;br&gt;· Se crean &lt;b&gt;dos asientos&lt;/b&gt;: TRANSFER_OUT y TRANSFER_IN, enlazados por referenceTransactionId.&lt;br&gt;· Si el crédito falla, se compensa el débito antes de responder el error.&lt;br&gt;· Cada llamada REST viaja con Circuit Breaker de 2 s; si ms-account abre el circuito → 503 del gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="640" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c55" value="&lt;b&gt;Qué guarda cada servicio&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #BBF7D0;margin:7px 0&quot;&gt;&lt;/div&gt;&lt;b&gt;ms-account&lt;/b&gt; · saldo y movimientos del mes de cada cuenta. No conoce el ledger.&lt;br&gt;&lt;br&gt;&lt;b&gt;ms-transaction&lt;/b&gt; · los dos asientos con saldos previo/nuevo, fee, moneda y referencia cruzada. No modifica saldos directamente.&lt;br&gt;&lt;br&gt;&lt;b&gt;ms-customer&lt;/b&gt; · solo se consulta: no participa en la transacción ni guarda movimientos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="710" y="1030" width="600" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;Errores y observabilidad&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #E2E8F0;margin:7px 0&quot;&gt;&lt;/div&gt;404 · cuenta o cliente inexistente&lt;br&gt;422 · saldo insuficiente, moneda distinta o cliente inactivo&lt;br&gt;503 · ms-account no disponible o Circuit Breaker abierto&lt;br&gt;&lt;br&gt;La respuesta de error conserva el mensaje del servicio remoto. El &lt;b&gt;X-Correlation-Id&lt;/b&gt; del gateway atraviesa ms-transaction y ms-account, de modo que Loki/Grafana reconstruyen la traza completa de la transferencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1030" width="600" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="14 - Secuencia pago de credito" id="page-14">
    <mxGraphModel dx="1980" dy="1270" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1270" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="14 · SECUENCIA · PAGO Y CONSUMO DE CRÉDITO (REST)" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1560" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="ms-transaction valida al cliente y delega el movimiento en ms-credit · el cupo y el estado del producto se recalculan en el dominio de crédito" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=0;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1560" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;FASE III · PROYECTO FINAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px&quot;&gt;Diagrama de secuencia / estados · UML&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
