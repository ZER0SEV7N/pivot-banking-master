        <mxCell id="c25" value="&lt;div style=&quot;text-align:left;font-weight:bold;font-size:10.5px;color:#6D28D9;margin-bottom:6px&quot;&gt;TABLA DE RUTAS · lb:// resuelto por Eureka&lt;/div&gt;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;table-layout:fixed&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:300px&quot;/&gt;&lt;col style=&quot;width:300px&quot;/&gt;&lt;col style=&quot;width:780px&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#F5F3FF;color:#6D28D9&quot;&gt;Predicado (path)&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#F5F3FF;color:#6D28D9&quot;&gt;Servicio destino&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#F5F3FF;color:#6D28D9&quot;&gt;Filtros / política&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/auth/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Público · sin JWT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/customers/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-customer&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE y /reactivate → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/accounts/** · /api/v1/debit-cards/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-account&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/credits/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-credit&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/transactions/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-transaction&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE y /reverse → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/yanki/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-yanki&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/actuator/** · /fallback/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;gateway / servicio&lt;/td&gt;&lt;td style=&quot;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Público · health y respuesta 503&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="306" width="1380" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:left;font-weight:bold;font-size:10.5px;color:#BE123C;margin-bottom:6px&quot;&gt;RBAC · RouteSecurityPolicy&lt;/div&gt;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;table-layout:fixed&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:250px&quot;/&gt;&lt;col style=&quot;width:360px&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFF1F2;color:#BE123C&quot;&gt;Acción&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#FFF1F2;color:#BE123C&quot;&gt;Rol requerido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#BE123C;background:#FFF1F2;&quot;&gt;GET · POST · PUT · PATCH&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ROLE_USER o ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#BE123C;background:#FFF1F2;&quot;&gt;DELETE&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#BE123C;background:#FFF1F2;&quot;&gt;PATCH …/reactivate&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#BE123C;background:#FFF1F2;&quot;&gt;POST …/reverse&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#BE123C;background:#FFF1F2;&quot;&gt;/api/v1/auth/** · /actuator/**&lt;/td&gt;&lt;td style=&quot;border:1px solid #FECDD3;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;sin token&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FECDD3;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="592" width="660" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Resiliencia y propagación&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #FCD34D;margin:7px 0&quot;&gt;&lt;/div&gt;Circuit Breaker Resilience4j por ruta · timeout 2 s&lt;br&gt;Fallback a &lt;b&gt;503 Service Unavailable&lt;/b&gt; con cuerpo FallbackResponse&lt;br&gt;El filtro propaga al servicio: &lt;b&gt;X-Auth-User&lt;/b&gt; · &lt;b&gt;X-Auth-Role&lt;/b&gt; · &lt;b&gt;X-Auth-Customer-Id&lt;/b&gt; · &lt;b&gt;X-Correlation-Id&lt;/b&gt;&lt;br&gt;El token se valida una sola vez en el borde; los servicios confían en las cabeceras internas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1680" y="592" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Por qué el gateway no es hexagonal&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #DDD6FE;margin:8px 0&quot;&gt;&lt;/div&gt;No contiene lógica de negocio: es un &lt;b&gt;proxy de borde&lt;/b&gt;. Su responsabilidad es transversal: correlación, autenticación, autorización, enrutamiento y resiliencia.&lt;br&gt;&lt;br&gt;&lt;b&gt;Orden de la cadena&lt;/b&gt;&lt;br&gt;1. CorrelationIdFilter — asigna X-Correlation-Id antes de cualquier log.&lt;br&gt;2. JwtAuthenticationFilter — omite rutas públicas; valida firma HS256 y expiración; responde 401 si falla.&lt;br&gt;3. RouteSecurityPolicy — aplica RBAC (DELETE, reactivate, reverse solo ROLE_ADMIN).&lt;br&gt;4. RoutePredicate + lb:// — Eureka elige instancia; Resilience4j corta y redirige al fallback.&lt;br&gt;&lt;br&gt;El resto de servicios ven las cabeceras X-Auth-* ya verificadas y no vuelven a validar el JWT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="900" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Configuración relevante · application.yaml&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #E2E8F0;margin:8px 0&quot;&gt;&lt;/div&gt;spring.cloud.gateway.routes → id, uri lb://, predicates Path, filters CircuitBreaker + fallback&lt;br&gt;resilience4j.circuitbreaker.instances.* → slidingWindow, failureRateThreshold, waitDurationInOpenState&lt;br&gt;jwt.enabled · jwt.secret (inyectado desde Vault) · rutas públicas declaradas en RouteSecurityPolicy&lt;br&gt;&lt;br&gt;&lt;b&gt;Convención de errores:&lt;/b&gt; 401 credencial inválida · 403 rol insuficiente · 503 servicio no disponible (fallback).&lt;br&gt;El cuerpo de error conserva timestamp, status, service, path y message para que Grafana pueda correlacionarlo con Loki." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="820" width="1380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Cómo leerlo&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;──►&lt;/b&gt; paso de la cadena de filtros &amp;nbsp;·&amp;nbsp; los filtros se ejecutan en orden (&lt;b&gt;HIGHEST_PRECEDENCE&lt;/b&gt; y &lt;b&gt;-50&lt;/b&gt;) antes del enrutamiento &amp;nbsp;·&amp;nbsp; &lt;b&gt;RouteSecurityPolicy&lt;/b&gt; concentra la whitelist y el RBAC &amp;nbsp;·&amp;nbsp; &lt;b&gt;GatewayFallbackController&lt;/b&gt; traduce la indisponibilidad a 503 y conserva el service/path para la traza." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="2320" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
