        <mxCell id="c24" value="&lt;b&gt;Orden de despliegue&lt;/b&gt;&lt;br&gt;00 namespace → 01 configmap → 02 secrets → 03 infraestructura&lt;br&gt;→ 04 plataforma → 05 microservicios → 06 gateway&lt;br&gt;→ 07 observabilidad → 08 promtail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;dashed=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
