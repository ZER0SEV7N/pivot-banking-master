        <mxCell id="c53" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=7.6;fontStyle=0;fontColor=#64748B;fontFamily=Helvetica;" value="error remoto (no persiste asiento)" vertex="1">
          <mxGeometry height="13" width="200" x="300" y="874" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;Reverso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.3px&quot;&gt;Se crea un &lt;b&gt;nuevo asiento&lt;/b&gt; con el tipo compensatorio (p. ej. WITHDRAWAL ↔ DEPOSIT), referenceTransactionId = id original, y el original pasa a REVERSED.&lt;br&gt;&lt;br&gt;canBeReversed = COMPLETED y sin referenceTransactionId.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="350" x="56" y="950" as="geometry" />
