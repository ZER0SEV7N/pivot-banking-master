        <mxCell id="c42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:left;font-weight:bold;font-size:10.5px;color:#1D4ED8;margin-bottom:6px&quot;&gt;DEPENDENCIAS SÍNCRONAS (REST · WebClient · CB 2 s)&lt;/div&gt;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;table-layout:fixed&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:34px&quot;/&gt;&lt;col style=&quot;width:250px&quot;/&gt;&lt;col style=&quot;width:380px&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#EFF6FF;color:#1D4ED8&quot;&gt;#&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#EFF6FF;color:#1D4ED8&quot;&gt;Origen → destino&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:5px 6px;font-size:9.5px;font-weight:bold;background:#EFF6FF;color:#1D4ED8&quot;&gt;Propósito&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-credit → ms-customer&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Valida cliente ACTIVE y tipo PERSONAL/BUSINESS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account → ms-credit&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Tarjeta activa y deuda OVERDUE (apertura y pagos)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account → ms-customer&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Perfil VIP / PYME y estado del cliente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-account&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Débito / crédito de saldo y pago con tarjeta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-credit&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Pago y consumo sobre producto de crédito&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-customer&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Valida que el cliente siga activo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-gateway → 6 servicios&lt;/td&gt;&lt;td style=&quot;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Rutas lb:// resueltas por Eureka (tabla de rutas)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
