        <mxCell id="c13" value="&lt;b style=&quot;font-size:9.6px;color:#6D28D9&quot;&gt;Reglas de negocio&lt;/b&gt;&lt;div style=&quot;height:3px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;line-height:1.5;color:#334155&quot;&gt;Todo asiento nace COMPLETED o REJECTED&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;line-height:1.5;color:#334155&quot;&gt;reverse() crea el asiento compensatorio y marca REVERSED&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;line-height:1.5;color:#334155&quot;&gt;Transferencia = TRANSFER_OUT + TRANSFER_IN&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;line-height:1.5;color:#334155&quot;&gt;Yanki solo registra resultados COMPLETED (idempotente)&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;line-height:1.5;color:#334155&quot;&gt;Los saldos llegan como snapshot de account / credit&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
