  "title": "Pivot Banking · Métricas y Logs (Loki)",
  "uid": "pivot-banking-observability",
  "version": 2,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eventos de log",
      "description": "Total de líneas de log ingeridas por Loki en el rango seleccionado (métrica derivada de logs).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"pivot-banking\", service=~\"$service\", level=~\"$level\"}[$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
