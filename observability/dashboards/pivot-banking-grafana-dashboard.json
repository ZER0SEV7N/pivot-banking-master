        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "type": 1,
          "label": "service",
          "stream": "{job=\"pivot-banking\"}"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "Todos",
          "value": "$__all"
