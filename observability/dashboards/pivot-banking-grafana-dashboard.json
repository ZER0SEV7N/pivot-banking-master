        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "Todos",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Correlation ID / texto",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
