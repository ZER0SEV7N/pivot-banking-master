d;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/customers/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-customer&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE y /reactivate → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/accounts/** · /api/v1/debit-cards/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-account&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/credits/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-credit&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/transactions/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-transaction&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE y /reverse → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/api/v1/yanki/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;lb://ms-yanki&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;JWT · DELETE → ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#6D28D9;background:#F5F3FF;&quot;&gt;/actuator/** · /fallback/**&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;gateway / servicio&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #DDD6FE;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Público · health y respuesta 503&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
