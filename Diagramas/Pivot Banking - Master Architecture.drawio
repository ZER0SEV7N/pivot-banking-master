break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account → ms-credit&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Tarjeta activa y deuda OVERDUE (apertura y pagos)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-account → ms-customer&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Perfil VIP / PYME y estado del cliente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-account&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Débito / crédito de saldo y pago con tarjeta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-credit&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Pago y consumo sobre producto de crédito&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-transaction → ms-customer&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Valida que el cliente siga activo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;font-weight:bold;color:#1D4ED8;background:#EFF6FF;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;ms-gateway → 6 servicios&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;border:1px solid #E2E8F0;padding:4px 6px;font-size:9.5px;text-align:left;vertical-align:top;&quot;&gt;Rutas lb:// resueltas por Eureka (tabla de rutas)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
