        </mxCell>
        <mxCell id="c56" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#475569;fontFamily=Helvetica;" value="PETICIÓN PROTEGIDA · JWT + RBAC en el borde" vertex="1">
          <mxGeometry height="14" width="500" x="126" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;JWT emitido por ms-auth&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.3px&quot;&gt;HS256 · claims: sub · role · customerId · iat · exp&lt;br&gt;El token nunca se guarda: lo verifica el gateway.&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="232" x="712" y="518.5" as="geometry" />
        </mxCell>
        <mxCell id="c58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;Matriz RBAC · RouteSecurityPolicy&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #DDD6FE;margin:7px 0&quot;&gt;&lt;/div&gt;&lt;table style=&quot;font-size:8.7px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;&lt;b&gt;GET · POST · PUT · PATCH&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;ROLE_USER o ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;&lt;b&gt;DELETE&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;solo ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;&lt;b&gt;PATCH …/reactivate&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;solo ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;&lt;b&gt;POST …/reverse&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px;border-bottom:1px solid #E2E8F0&quot;&gt;solo ROLE_ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px&quot;&gt;&lt;b&gt;/api/v1/auth/** · /actuator/**&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;word-wrap:break-word;overflow-wrap:anywhere;padding:3px 4px&quot;&gt;sin token&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:8px;color:#475569;margin-top:6px&quot;&gt;El gateway aplica CorrelationIdFilter → JwtAuthenticationFilter → RouteSecurityPolicy antes de enrutar.&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="404" x="40" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="c59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;Estructura del token&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #99F6E4;margin:7px 0&quot;&gt;&lt;/div&gt;&lt;b&gt;header&lt;/b&gt; · alg HS256, typ JWT&lt;br&gt;&lt;b&gt;payload&lt;/b&gt; · sub (username) · role · customerId · iat · exp&lt;br&gt;&lt;b&gt;signature&lt;/b&gt; · HMAC-SHA256(header.payload, jwt-secret-key)&lt;br&gt;&lt;br&gt;&lt;b&gt;Validación en el borde:&lt;/b&gt; firma correcta, token no expirado y rol autorizado para el método y la ruta. Si es válido, el gateway propaga la identidad y los servicios no vuelven a validar el JWT.&lt;br&gt;&lt;b&gt;caducidad:&lt;/b&gt; jwt-expiration-ms (Vault) · sin refresh token en esta versión." vertex="1">
          <mxGeometry height="156" width="381" x="467" y="1034" as="geometry" />
        </mxCell>
        <mxCell id="c60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;Errores y trazabilidad&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #E2E8F0;margin:7px 0&quot;&gt;&lt;/div&gt;401 Unauthorized · token ausente, firma inválida o expirado&lt;br&gt;403 Forbidden · autenticado pero sin ROLE_ADMIN para DELETE / reactivate / reverse&lt;br&gt;503 Service Unavailable · ms-auth caído o Circuit Breaker abierto (fallback del gateway)&lt;br&gt;&lt;br&gt;Todas las peticiones llevan &lt;b&gt;X-Correlation-Id&lt;/b&gt;; el gateway añade &lt;b&gt;X-Auth-User&lt;/b&gt;, &lt;b&gt;X-Auth-Role&lt;/b&gt; y &lt;b&gt;X-Auth-Customer-Id&lt;/b&gt;. Logback los incluye en cada línea y Promtail los envía a Loki para correlacionar en Grafana." vertex="1">
          <mxGeometry height="156" width="422" x="868" y="1034" as="geometry" />
        </mxCell>
        <mxCell id="ocMZLd-ORbUx75ypZqGa-1" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;labelPerimeter=1;fontColor=default;" value="&lt;span style=&quot;&quot;&gt;&lt;b style=&quot;text-align: left; white-space: normal; font-size: 9.6px;&quot;&gt;Cliente / Postman&lt;/b&gt;&lt;br style=&quot;font-size: 11px; text-align: left; white-space: normal;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; white-space: normal; font-size: 7.9px;&quot;&gt;usuario final&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="30" x="103" y="86" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
